{
  "name": "image-editor",
  "version": "1.0.0",
  "description": "Editor de imagenes con Managed Agents (Gemini Interactions API) y Nano Banana",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node --env-file ../.env server.js",
    "dev": "node --env-file ../.env --watch server.js",
    "manage:agent": "node --env-file ../.env scripts/manage-agent.js",
    "setup:agent": "node --env-file ../.env scripts/manage-agent.js --create",
    "list:agents": "node --env-file ../.env scripts/manage-agent.js --list",
    "delete:agent": "node --env-file ../.env scripts/manage-agent.js --delete"
  },
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^2.13.0",
    "express": "^4.19.2",
    "multer": "^2.0.1",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "playwright": "^1.61.1"
  }
}
